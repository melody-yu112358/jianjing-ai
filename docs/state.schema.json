{
  "$defs": {
    "Ritual": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "enum": [
            "assess",
            "guided_breathing",
            "settling",
            "switch_method",
            "fade_out",
            "end"
          ],
          "title": "Stage",
          "type": "string"
        },
        "inhale_sec": {
          "minimum": 0,
          "title": "Inhale Sec",
          "type": "number"
        },
        "exhale_sec": {
          "minimum": 0,
          "title": "Exhale Sec",
          "type": "number"
        },
        "action": {
          "enum": [
            "continue_breathing",
            "slow_down",
            "reduce_stimulation",
            "switch_to_natural_breathing",
            "switch_to_grounding",
            "fade_out",
            "end"
          ],
          "title": "Action",
          "type": "string"
        },
        "audio_intensity": {
          "maximum": 1,
          "minimum": 0,
          "title": "Audio Intensity",
          "type": "number"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "inhale_sec",
        "exhale_sec",
        "action",
        "audio_intensity",
        "reason"
      ],
      "title": "Ritual",
      "type": "object"
    },
    "Signals": {
      "additionalProperties": false,
      "properties": {
        "heart_rate": {
          "exclusiveMinimum": 0,
          "title": "Heart Rate",
          "type": "number"
        },
        "resp_rate": {
          "exclusiveMinimum": 0,
          "title": "Resp Rate",
          "type": "number"
        }
      },
      "required": [
        "heart_rate",
        "resp_rate"
      ],
      "title": "Signals",
      "type": "object"
    },
    "State": {
      "additionalProperties": false,
      "properties": {
        "arousal": {
          "maximum": 1,
          "minimum": 0,
          "title": "Arousal",
          "type": "number"
        },
        "stability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Stability",
          "type": "number"
        },
        "trend": {
          "enum": [
            "up",
            "down",
            "flat"
          ],
          "title": "Trend",
          "type": "string"
        },
        "state_class": {
          "enum": [
            "activated",
            "settling",
            "stable",
            "not_responding",
            "discomfort",
            "ready_to_disengage"
          ],
          "title": "State Class",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "arousal",
        "stability",
        "trend",
        "state_class",
        "confidence",
        "reason_codes"
      ],
      "title": "State",
      "type": "object"
    },
    "Visual": {
      "additionalProperties": false,
      "properties": {
        "intensity": {
          "maximum": 1,
          "minimum": 0,
          "title": "Intensity",
          "type": "number"
        },
        "noise": {
          "maximum": 1,
          "minimum": 0,
          "title": "Noise",
          "type": "number"
        },
        "speed": {
          "maximum": 1,
          "minimum": 0,
          "title": "Speed",
          "type": "number"
        }
      },
      "required": [
        "intensity",
        "noise",
        "speed"
      ],
      "title": "Visual",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "timestamp": {
      "description": "Unix UTC seconds, not milliseconds",
      "minimum": 0,
      "title": "Timestamp",
      "type": "number"
    },
    "signals": {
      "$ref": "#/$defs/Signals"
    },
    "state": {
      "$ref": "#/$defs/State"
    },
    "ritual": {
      "$ref": "#/$defs/Ritual"
    },
    "visual": {
      "$ref": "#/$defs/Visual"
    },
    "message": {
      "title": "Message",
      "type": "string"
    }
  },
  "required": [
    "timestamp",
    "signals",
    "state",
    "ritual",
    "visual",
    "message"
  ],
  "title": "Frame",
  "type": "object"
}
